# Database Configuration
# For Local Zero-Config SQLite (Default):
DATABASE_URL=sqlite:///./skin_intelligence.db

# For PostgreSQL (Docker / Production / Managed Cloud DB):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skin_intelligence

# JWT Secret & Security
SECRET_KEY=skin-intelligence-super-secret-key-change-in-production-2024
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Ports
PORT=8000
FRONTEND_PORT=5173

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000

# Docker PostgreSQL Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skin_intelligence

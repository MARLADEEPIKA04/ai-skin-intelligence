{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Backend: FastAPI (Debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--port",
        "8000",
        "--host",
        "127.0.0.1"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "🧪 Backend: Run Pytest Suite",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "tests"
      ],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "🎨 Frontend: Chrome Debugger",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "⚡ Full Stack: FastAPI + Chrome",
      "configurations": [
        "🚀 Backend: FastAPI (Debug)",
        "🎨 Frontend: Chrome Debugger"
      ],
      "stopAll": true
    }
  ]
}
